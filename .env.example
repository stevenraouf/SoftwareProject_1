# Copy to backend/.env. Never commit real values.
NODE_ENV=development
# Optional absolute path to a separately installed patched Node 22 executable.
NODE_RUNTIME_PATH=
PORT=3443
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/travel_platform
APP_ORIGIN=https://localhost:3443
CORS_ORIGINS=https://localhost:3443,https://localhost:3000
TLS_KEY_PATH=../.certs/localhost-key.pem
TLS_CERT_PATH=../.certs/localhost.pem
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PLATFORM_CURRENCY=USD
APP_TIMEZONE=Africa/Cairo
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional path to stripe.exe when the CLI is not on PATH.
STRIPE_CLI_PATH=
FX_API_KEY=
FX_API_URL=https://api.fxratesapi.com/latest
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Travel Platform <travel@example.test>
ENABLE_EMAIL_BONUS=false
# Optional loopback-only development SMTP inbox. Requires a verified Mailpit binary.
SMTP_TEST_INBOX=
MAILPIT_PATH=
MAILPIT_HTTP_PORT=8025
STORAGE_PATH=./storage
ENABLE_JOBS=true
