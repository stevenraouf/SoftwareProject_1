{
  "name": "aeris-frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --webpack --hostname localhost --experimental-https --experimental-https-key ../.certs/localhost-key.pem --experimental-https-cert ../.certs/localhost.pem",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@stripe/react-stripe-js": "7.1.0",
    "@stripe/stripe-js": "10.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
