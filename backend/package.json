{
  "name": "travel-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Software Project I travel planning and booking API",
  "engines": {
    "node": ">=22.14 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:local": "node scripts/start-local.mjs",
    "start:dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=integration",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --json --outputFile=../docs/milestone-1/evidence/api-test-results.json && node scripts/api-report.mjs",
    "seed": "npm run build && node dist/seed.js",
    "seed:demo": "npm run build && node dist/seed.js --demo",
    "certs": "node scripts/certs.mjs",
    "check:atlas": "node scripts/check-atlas.mjs",
    "check:live": "node scripts/check-live-api.mjs",
    "check:stripe": "node scripts/check-stripe.mjs",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "verify:stripe": "npm run build && node scripts/verify-stripe.mjs",
    "verify:bonuses": "npm run build && node scripts/verify-bonuses.mjs",
    "openapi": "npm run build && node dist/openapi.js",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.spec.ts"
    ],
    "testTimeout": 120000,
    "maxWorkers": 1,
    "clearMocks": true,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "moduleResolution": "bundler"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/mongoose": "12.0.1",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/swagger": "12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "helmet": "8.3.0",
    "jpeg-js": "0.4.4",
    "jsonwebtoken": "9.0.3",
    "luxon": "3.7.2",
    "mongoose": "9.12.1",
    "multer": "2.5.0",
    "nodemailer": "10.5.0",
    "pdfkit": "0.20.2",
    "pngjs": "7.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/luxon": "3.7.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pngjs": "6.0.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.10.1",
    "selfsigned": "5.5.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "type": "module",
  "overrides": {
    "minimatch": "11.0.8",
    "glob": "14.0.6"
  }
}
